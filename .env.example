# EdgeSight planner server — copy to server/.env and edit as needed.
# NEVER commit a real .env. NEVER put keys in the extension or demo-page.
# The extension only ever talks to this local server with SANITIZED data.

# Planner mode: "mock" (deterministic, default for the prototype) or "llm" (optional, later).
PLANNER_MODE=mock

# Server bind port.
PORT=8000

# CORS origin allowed to call the planner (extension/demo run locally).
ALLOWED_ORIGIN=*

# --- Optional LLM planner (only if PLANNER_MODE=llm; added in a later phase) ---
# One provider only for the prototype. The key is read from THIS env on the
# server and is never sent to or stored in the browser. Leave commented for mock mode.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001
